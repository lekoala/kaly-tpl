<?php

/**
 * @var \Kaly\Tpl\HtmlView $v
 * @var array{label: string, url: string, children: array} $item
 * @var \Kaly\Tpl\Loop $loop
 */

$children = $item['children'] ?? [];
?>
<li<?= $v->attrs([
    'class' => ['menu-item', 'has-children' => $children !== []],
    'data-depth' => $loop->depth(),
]) ?>>
    <a href="<?= $v->url($item['url']) ?>"><?= $v->e($item['label']) ?></a>

    <?php if ($children !== []): ?>
        <ul class="submenu">
            <?= $v->each($children, 'menu/item', $loop->nested(as: 'item')) ?>
        </ul>
    <?php endif ?>
</li>
